@inherits LayoutComponentBase

<AuthorizeView>
    <Authorized>
        <div class="page">
            <div class="sidebar">
                <NavMenu />
            </div>

            <main>
                <article class="content px-4">
                    @Body
                </article>
            </main>
        </div>
    </Authorized>
    <NotAuthorized>
        <div style="max-width:320px;margin:80px auto;">
            <h5>Sign in to continue</h5>
            <form action="/pres/login" method="post">
                <label class="form-label" for="username">Username</label>
                <input id="username" name="username" autocomplete="username" class="form-control mb-2" required />
                <label class="form-label" for="password">Password</label>
                <input id="password" name="password" type="password" autocomplete="current-password" class="form-control mb-3" required />
                <button type="submit" class="btn btn-primary">Sign in</button>
            </form>
        </div>
    </NotAuthorized>
</AuthorizeView>
